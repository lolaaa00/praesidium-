# Frontend Environment Variables
# Copy to .env.local and fill in values

# Hosted Supabase for local dev
NEXT_PUBLIC_SUPABASE_URL=https://vfkldbqbzboifslaqxkk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

NEXT_PUBLIC_GENLAYER_CONTRACT_ADDRESS=0x6EfCE1EaA68DEd9C09b27DAd88EFA8804c72E600
NEXT_PUBLIC_GENLAYER_NETWORK=studionet

# Encrypts each agent's GenLayer private key at rest (generated at agent
# registration). Must match apps/engine's value exactly — the engine
# decrypts with this same secret to sign that agent's validate_action calls.
AGENT_KEY_ENCRYPTION_SECRET=your-long-random-secret

# Internal server-side URL for the validation engine (used by Next.js API routes)
ENGINE_URL=http://localhost:3001
