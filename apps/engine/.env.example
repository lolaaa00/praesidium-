# Validation Engine Environment
PORT=3001
NODE_ENV=development

# Supabase (service role - bypasses RLS)
# Local dev: http://localhost:54321 (supabase start)
# Production: https://vfkldbqbzboifslaqxkk.supabase.co
SUPABASE_URL=https://vfkldbqbzboifslaqxkk.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# GenLayer
# No shared signing key — every agent has its own GenLayer keypair,
# generated at registration (apps/web) and decrypted here per validate_action
# call (apps/engine/src/lib/agent-key.ts). Must match the web app's value.
AGENT_KEY_ENCRYPTION_SECRET=your-long-random-secret
GENLAYER_CONTRACT_ADDRESS=0x6EfCE1EaA68DEd9C09b27DAd88EFA8804c72E600
GENLAYER_RPC_URL=https://studio.genlayer.com/api
