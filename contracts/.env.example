# Deployer account — must hold GEN on the target network.
# Generate one with: node -e "console.log(require('genlayer-js').generatePrivateKey())"
GENLAYER_PRIVATE_KEY=your-deployer-private-key

# StudioNet RPC endpoint
GENLAYER_RPC_URL=https://studio.genlayer.com/api

# Filled in by deploy.ts after a successful deployment — leave blank before deploying.
GENLAYER_CONTRACT_ADDRESS=
